# Copy to .env. Everything is optional: with nothing set the app runs on an
# in-process Postgres (PGlite) with the rule-based briefing.

# Neon (or any Postgres). Use the *pooled* connection string.
DATABASE_URL=
# Without DATABASE_URL: keep the local PGlite database between restarts.
PGLITE_DIR=./data/pglite

# LLM briefing + stock advice: tried in this order, falls back to rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
AI_DISABLED=false

# Canteen
SLOT_CAPACITY=30
SEED_BOOKINGS=true
TZ_OFFSET_MIN=330
DEMO_PASSWORD=demo1234
